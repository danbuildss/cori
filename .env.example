# Claude
ANTHROPIC_API_KEY=sk-ant-...

# Telegram (same bot as CORTX)
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# CORTX webhook auth
CORTX_WEBHOOK_SECRET=...

# x402 payment gate (Base mainnet)
# Receiving address only. Never put a private key on an agent server.
X402_PAY_TO_ADDRESS=0x...
X402_REQUIRED_AMOUNT_USDC=0.10

# Sibyl Memory
SIBYL_DB_PATH=~/.sibyl/memory.db

# Agent config
LOG_LEVEL=INFO
PORT=8000
